# URL del Servidor WebSocket/HTTP del Orquestador de Agentes en VPS (ej: wss://agente.ovnistudio.com/ws)
NEXT_PUBLIC_AGENT_SERVER_URL=

# URL del agente de IA local (IA_LOCAL_RAG). Su server corre en el puerto 8001 porque Chroma usa el 8000
NEXT_PUBLIC_AGENT_LOCAL_URL=ws://localhost:8001/ws/agent

# Backend con el que arranca la landing: "remote" (default) o "local"
NEXT_PUBLIC_AGENT_BACKEND=remote

# Forzar el modo Mock Server local para desarrollo en memoria (true / false)
NEXT_PUBLIC_USE_MOCK_AGENT=false
